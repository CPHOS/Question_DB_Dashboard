# Question_DB_Dashboard — full-stack (db + api + web) Docker Compose template.
# Copy to `.env` and edit the secrets, then:
#     docker compose -f docker-compose.prod.yml up -d --build
#
# The same variable layout is used by the Question_DB backend repo, so the
# secrets (POSTGRES_PASSWORD, QB_JWT_SECRET, QB_DATABASE_URL) must match the
# image you build there. See DEPLOYMENT.md.

# ── PostgreSQL ───────────────────────────────────────
POSTGRES_DB=qb
POSTGRES_USER=qb
POSTGRES_PASSWORD=change-this-password
QB_POSTGRES_MAJOR=16

# ── Backend (API) ───────────────────────────────────
# QB_DATABASE_URL must use the SAME password as POSTGRES_PASSWORD and the
# compose service name `db` as host.
QB_DATABASE_URL=postgres://qb:change-this-password@db:5432/qb
QB_JWT_SECRET=change-this-to-a-long-random-string
QB_API_PORT=8080
QB_MAX_DB_CONNECTIONS=20
QB_EXPORT_DIR=/var/lib/qb/exports
QB_OBJECT_STORE_DIR=/var/lib/qb/objects
# Comma-separated list. For sub-path production behind one origin, leave empty
# (same-origin) or set the public origin(s).
QB_CORS_ORIGINS=

# ── Frontend (Web / SPA) ────────────────────────────
# Where the browser should call the API from. Two common cases:
#   • Sub-path behind a reverse proxy (recommended):  /question_db/api
#     (the reverse proxy forwards /question_db/api/* to the api container)
#   • Separate origin / local dev:                    http://localhost:8080
VITE_API_BASE=/question_db/api
# Base path the SPA is served from. Production sub-path: /question_db .
# Root deployment: leave empty.
QB_BASE_PATH=/question_db
QB_WEB_PORT=80

# ── Images ──────────────────────────────────────────
# qb_api is built from the Question_DB repo: `docker build -t qb_api:latest ./Question_DB`
QB_API_IMAGE=qb_api
QB_API_TAG=latest
QB_WEB_IMAGE=qb_dashboard
QB_WEB_TAG=latest
